  "7": "ಹೆಚ್ಚುವರಿ",
  "8": "ಹಂಚಿಕೊಳ್ಳಿ",
  "9": "ಗ್ಯಾಲರಿ",
  "10": "ನಮಗೆ ರೇಟಿಂಗ್ ನೀಡಿ",
  "11": "ಇನ್ನಷ್ಟು ಆ್ಯಪ್‌ಗಳು",
  "12": "ಗೌಪ್ಯತಾ ನೀತಿ",
  "13": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು",
  "14": "ಬೈಬಲ್‌ನ 116 ಕಥೆಗಳನ್ನು ಆನಂದಿಸಿ. ಅವು ನಿಖರವಾದವು, ಅರ್ಥವಾಗುವವು ಮತ್ತು ಸುಂದರವಾಗಿ ಚಿತ್ರಿಸಲ್ಪಟ್ಟಿವೆ.",
  "15": "ಅಕ್ಷರರೂಪ ಬದಲಿಸಿ:",
  "16": "ಅಕ್ಷರದ ಗಾತ್ರ ಮತ್ತು ಪಠ್ಯ ಜೋಡಣೆ ಬದಲಿಸಿ:",
  "17": "ಇದು ಆ್ಯಪ್‌ನ ಪಠ್ಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪರೀಕ್ಷಿಸಲು ಮಾದರಿ ಪಠ್ಯ.",
  "18": "ವಿಷಯಗಳು",
  "19": "ಭಾಗ 1",
  "20": "ಸೃಷ್ಟಿಯಿಂದ ಹಳವಿಗೆಯವರೆಗೆ",
  "21": "ಭಾಗ 2",
  "22": "ಹಳವಿಗೆಯಿಂದ ಈಜಿಪ್ಟ್‌ನಿಂದ ಮುಕ್ತಿಯವರೆಗೆ",
  "23": "ಭಾಗ 3",
  "24": "ಈಜಿಪ್ಟ್ ಮುಕ್ತಿಯಿಂದ ಇಸ್ರಾಯೇಲದ ಮೊದಲ ರಾಜವರೆಗೆ",
  "25": "ಹಿಂದೆ",
  "26": "ಭಾಗ 4",
  "27": "ಇಸ್ರಾಯೇಲದ ಮೊದಲ ರಾಜನಿಂದ ಬಾಬಿಲಿನ ಗುಲಾಮಗೆಯವರೆಗೆ",
  "28": "ಭಾಗ 5",
  "29": "ಬಾಬಿಲಿನ ಗುಲಾಮಗೆಯಿಂದ ಜರುಶಲೇಮ ಕೋವುಗಳ ಮರುನಿರ್ಮಾಣದವರೆಗೆ",
  "30": "ಭಾಗ 6",
  "31": "ಯೇಸುವಿನ ಜನನದಿಂದ ಅವನ ಮೃತ್ಯುವರೆಗೆ",
  "32": "ಯೇಸುವಿನ ಪುನರುತ್ಥಾನದಿಂದ ಪಾಲನ ಕ್ಸೆಮ್ಮೆಗೆಯವರೆಗೆ",
  "33": "ಭಾಗ 7",
  "34": "ಯೇಸುವಿನ ಪುನರುತ್ಥಾನದಿಂದ ಪಾಲನ ಕ್ಸೆಮ್ಮೆಗೆಯವರೆಗೆ",
  "35": "ಬೈಬಲ್ ತಿಳಿಸಿದದ್ದು ನಡೆಯುತ್ತದೆ",
  "36": "ಇದು ನಿಜವಾದ ಕಥೆಗಳ ಪುಸ್ತಕ. ಇವು ಜಗತ್ತಿನ ಅತ್ಯಂತ ದೊಡ್ಡ ಕೃತಿಯಾದ ಬೈಬಲ್‌ನಿಂದ ತೆಗೆದುಬಂದವು.",
  "37": "ಆಡಿಯೋ:",
  "38": "ಹಿಂದಿನದು",
  "39": "ಮುಂದಿನದು",
  "40": "ದಯವಿಟ್ಟು ಸಾಧನವನ್ನು ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸಿ",
  "41": "ಅಹಿವಾದಕ ಜಾಹ್ರಾತುಗಳಿಲ್ಲ. ಒಮ್ಮೆ ಪಾವತಿಯಿಂದ ಜಾಹ್ರಾತುಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ತೆಗೆದುಹಾಕಿ! ಈ ಅಫರ್ ಬಳಸಿ ಮತ್ತು ನಿಮ್ಮ ಇಷ್ಟದ ಕಥೆಗಳನ್ನು ಅಡಚಿನೆಯಿಲ್ಲದೆ ಓದಿ ಅಥವಾ ಕೇಳಿ!",
  "42": "ಜಾಹ್ರಾತುಗಳನ್ನು ತೆಗೆದುಹಾಕಿ",
  "43": "ಆ್ಯಪ್‌ನಿಂದ ಎಲ್ಲಾ ಜಾಹ್ರಾತುಗಳನ್ನು ತೆಗೆದು ನಿಮ್ಮ ಅನುಭವವನ್ನು ಸುಧಾರಿಸಲು ಒಮ್ಮೆ ಪಾವತಿಸಿ.",
  "44": "ಸೇರಿದ ಪ್ರಯೋಜನಗಳು:",
  "45": "ಡಾರ್ಕ್ ಮೋಡ್",
  "46": "ಸಕ್ರಿಯಗೊಳಿಸಿ",
  "47": "ಮುಚ್ಚಿ",
  "48": "ಅಂಬರ್ ಫಿಲ್ಟರ್ (ಪೇಪರ್ ಮೋಡ್)",
  "49": "ಲೋಡ್ ಆಗುತ್ತಿದೆ...",
  "50": "ಪ್ರತಿಭೆಗಳು",
  "51": "ಜಾಹ್ರಾತುಗಳಿಲ್ಲ!",
  "52": "ಜಾಹ್ರಾತು ಲೋಡ್ ಆಗುತ್ತಿದೆ...",
  "53": "ನಿಮಗೆ ಈಗಾಗಲೇ 24 ಗಂಟೆ ಜಾಹ್ರಾತು-ಮುಕ್ತ ಸಮಯ ಇದೆ!",
  "54": "ದೈನಂದಿನ ಮಿತಿ ತಲುಪಿದೆ",
  "55": "ಜಾಹ್ರಾತು ಲಭ್ಯವಿಲ್ಲ",
  "56": "ಜಾಹ್ರಾತು ನೋಡಿ",
  "57": "ಜಾಹ್ರಾತುಗಳಿಲ್ಲದೆ ಆ್ಯಪ್ ಅನ್ನು ಆನಂದಿಸಿ.",
  "58": "ಪ್ರತಿಭೆ ಪಡೆಯಲು ಒಂದು ಜಾಹ್ರಾತು ನೋಡಿ.\n5 ಪ್ರತಿಭೆಗಳು = 24 ಗಂಟೆ ಜಾಹ್ರಾತು-ಮುಕ್ತ!",
  "59": "ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ",
  "60": "ಮುಚ್ಚಿ",
  "61": "5 ರಲ್ಲಿ",
  "62": "ಇಂದಿನ ಜಾಹ್ರಾತುಗಳು: ",
  "63": "ನಿಮ್ಮ ಖರೀದಿಗೆ ಧನ್ಯವಾದಗಳು!",
  "64": "ಜಾಹ್ರಾತುಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಆ್ಯಪ್ ಅನ್ನು ಪೂರ್ಣಗೊಳಿಸಿ ಆನಂದಿಸಿ.",
  "65": "ಜಾಹ್ರಾತು-ಮುಕ್ತ ",
  "66": "ಜಾಹ್ರಾತುಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ತೆಗೆದುಹಾಕಿ",
  "67": "ಓದುವುದು ಇಷ್ಟವಾಗುತ್ತದೆ?",
  "68": "ಒಮ್ಮೆ ಪಾವತಿಯಿಂದ ಜಾಹ್ರಾತುಗಳನ್ನು ತೆಗೆದು ಅಡಚಿನೆಯಿಲ್ಲದೆ ಓದಿ.",
  "69": "ಅಫರ್ ನೋಡಿ",
  "70": "ಕಥೆಗಳನ್ನು ಹುಡುಕಿ...",
  "71": "ಅಭಿಮಮತಗಳು",
  "72": "ಯಾವುದೇ ಫಲಿತಾಂಶಗಳಿಲ್ಲ",
  "73": "ನಿಮಗೆ ಇನ್ನೂ ಅಭಿಮಮತಗಳಿಲ್ಲ",
  "74": "ಆಡಿಯೋ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ",
  "75": "ಆಡಿಯೋ ಡೌನ್‌ಲೋಡ್ ಆಗಿದೆ",
  "76": "ಆಡಿಯೋ ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ...",
  "77": "ಡೌನ್‌ಲೋಡ್‌ಗೆ ಸಂಪರ್ಕ ಬೇಕು",
  "78": "ಡೌನ್‌ಲೋಡ್ ಅಳಿಸಿ",
  "79": "ನಿರ್ಗಮಿಸಲು ಮತ್ತೆ ಹಿಂದೆ ಒತ್ತಿ",
  "80": "ಭಾಷೆಯನ್ನು %s ಆಗಿ ಬದಲಾಯಿಸಲಾಗಿದೆ."
